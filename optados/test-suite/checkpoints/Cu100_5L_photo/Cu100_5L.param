TASK: SPECTRAL
CUT_OFF_ENERGY: 354 eV

OPT_STRATEGY: Speed
XC_FUNCTIONAL: PBE
SPIN_POLARIZED: FALSE
PERC_EXTRA_BANDS: 25
ELEC_ENERGY_TOL: 1e-07 eV
