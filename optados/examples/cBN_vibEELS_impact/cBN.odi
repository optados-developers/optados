
# cBN impact-only example for phonon vib-EELS in OptaDOS.

# The data in the .phonon file was obtained from a CASTEP phonon task for
# bulk cBN on a 8x8x8 q-point grid, using the PBEsol functional. LO/TO splitting
# was enabled for this phonon calculation.

TASK             : phonon_eels
PHONON_EELS_TASK : impact

# min/max energy, and spacing, for calculation of all vib-EELS quantities.
# These are in meV.
#vibeels_min_energy : 0
#vibeels_max_energy : 200
vibeels_spacing    : 0.5

#*************************************
#           Impact Keywords          #
#*************************************

# Broadening for loss function, in meV.
vibeels_impact_broadening : 2.5
